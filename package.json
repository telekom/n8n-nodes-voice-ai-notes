{
  "name": "@t-digital/n8n-nodes-voice-ai-notes",
  "version": "0.5.1",
  "description": "n8n community node for Voice AI automatically receives call summaries via webhook and extracts tasks and appointments",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "cloudpbx",
    "voice ai",
    "call summary",
    "tasks",
    "appointments",
    "webhook",
    "telephony"
  ],
  "license": "MIT",
  "homepage": "https://github.com/telekom/n8n-nodes-voice-ai-notes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telekom/n8n-nodes-voice-ai-notes.git"
  },
  "bugs": {
    "url": "https://github.com/telekom/n8n-nodes-voice-ai-notes/issues"
  },
  "author": {
    "name": "André Rink",
    "email": "andre.rink@telekom.de"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "lint": "eslint --no-config-lookup -c eslint.config.mjs package.json \"nodes/**/*.{ts,js,json}\" \"credentials/**/*.{ts,js,json}\"",
    "scan": "npx @n8n/scan-community-package @t-digital/n8n-nodes-voice-ai-notes",
    "test": "npm run lint",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CloudPBXApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/VoiceAiNotesWebhook/VoiceAiNotesWebhook.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.31.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.29.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "n8n-workflow": "^2.30.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
